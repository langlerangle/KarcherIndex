theorem actual_bound (n : ℤ) :
    |(∑ i : Fin 256, (rationalKernelWeight n ((-6145 : ℤ)+i.val) : ℝ) *
        sample (2*((-6145 : ℤ)+i.val)+1)) -
      (blockLinearNumerator (-6145) n center : ℝ)/10^51| ≤
      (blockLinearRadius (-6145) n radius : ℝ)/10^51 := by
