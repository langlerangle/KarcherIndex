def mode (i : Fin 32) : ℤ :=
  let j := 192+i.val
  if j % 2 = 0 then (j/2+3 : ℕ) else -((j/2+3 : ℕ) : ℤ)
def row (i : Fin 32) : ℤ × ℤ × ℤ := entries[i.val]?.getD (0,0,0)
def lo (i : Fin 32) : ℚ := (row i).1 / 1000000000000
def hi (i : Fin 32) : ℚ := (row i).2.1 / 1000000000000
def energy (i : Fin 32) : ℚ := (row i).2.2 / 1000000000000000000
theorem arithmetic : ∀ i : Fin 32, lo i ≤ hi i ∧
  signedIntervalRadius (lo i) (hi i)^2 / residualWeightRat (mode i) ≤ energy i := by
  decide +kernel
theorem total : (∑ i : Fin 32, energy i) = (2550185636/1000000000000000000 : ℚ) := by
  decide +kernel
#print axioms arithmetic
#print axioms total
