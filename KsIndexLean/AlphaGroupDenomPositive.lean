module

public import KsIndexLean.AlphaRemainderGroupBounds

@[expose] public section


/-! Positivity of the exact group denominators on n ≥ 3.
Translation from powers of `n - 1024` to powers of `n - 3` gives strictly
positive coefficient arrays, proving positivity throughout this range. -/
namespace KsIndex.AlphaRemarkTrial.GroupBounds
set_option maxRecDepth 65536
set_option maxHeartbeats 4000000
set_option linter.style.longLine false

private theorem positive_sum {k : ℕ} (d : Fin k → ℤ) (hk : 0 < k)
    (hd : ∀ i, 0 < d i) (x : ℝ) (hx : 0 ≤ x) :
    0 < ∑ i : Fin k, (d i : ℝ) * x ^ i.val := by
  have hp (i : Fin k) : (0 : ℝ) < d i := by exact_mod_cast hd i
  have hh := Finset.single_le_sum
    (s := Finset.univ) (f := fun i : Fin k => (d i : ℝ) * x ^ i.val)
    (fun i _ => mul_nonneg (hp i).le (pow_nonneg hx _))
    (Finset.mem_univ (⟨0, hk⟩ : Fin k))
  simp only [pow_zero, mul_one] at hh
  exact (hp ⟨0, hk⟩).trans_le hh

