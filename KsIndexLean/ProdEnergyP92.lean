theorem checkedE (i : Fin 64) :
    (entriesE[i.val]?.getD (0, 0)).1 =
        tableSampleNumerator KsIndex.PositiveEnergyAlphaLowProd.tFast (2 * modeE i.val) ∧
    (entriesE[i.val]?.getD (0, 0)).2 =
        tableSampleRadius KsIndex.PositiveEnergyAlphaLowProd.tFast (2 * modeE i.val) := by
  fin_cases i <;> decide +kernel

def idxE (n : ℤ) : ℕ := (n - (-2304)).toNat

lemma mem_wP92 {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP92) : (-2305 : ℤ) < n ∧ n ≤ -2241 := by
  simpa only [KsIndex.NegSignProd.wP92, Finset.mem_Ioc] using hn

lemma idxE_lt {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP92) : idxE n < 64 := by
  obtain ⟨h1, h2⟩ := mem_wP92 hn; simp only [idxE]; omega

lemma two_modeE_idx {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP92) :
    2 * modeE (idxE n) = 2 * n + 0 := by
  obtain ⟨h1, h2⟩ := mem_wP92 hn; simp only [idxE, modeE]; omega

lemma covLowE {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP92) : SampleCovered 8196 (2 * n + 0) := by
  obtain ⟨h1, h2⟩ := mem_wP92 hn; exact sampleCovered_of_bound (by omega)

lemma covFastE {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP92) : SampleCovered 16389 (2 * n + 0) := by
  obtain ⟨h1, h2⟩ := mem_wP92 hn; exact sampleCovered_of_bound (by omega)

lemma sampleNumE_cache {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP92) :
    sampleNumerator (2 * n + 0) = (entriesE[idxE n]?.getD (0, 0)).1 := by
  have hc := (checkedE ⟨idxE n, idxE_lt hn⟩).1
  rw [two_modeE_idx hn] at hc
  have hbridge := tableSampleNumerator_eq KsIndex.PositiveEnergyAlphaLowProd.valid (covFastE hn)
  exact (hc.trans hbridge).symm

lemma sampleRadE_cache {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP92) :
    sampleRadius (2 * n + 0) = (entriesE[idxE n]?.getD (0, 0)).2 := by
  have hc := (checkedE ⟨idxE n, idxE_lt hn⟩).2
  rw [two_modeE_idx hn] at hc
  have hbridge := tableSampleRadius_eq KsIndex.PositiveEnergyAlphaLowProd.valid (covFastE hn)
  exact (hc.trans hbridge).symm

theorem eP92_c_fast :
    tableEnergyNumerator KsIndex.NegSignProd.t KsIndex.NegSignProd.wP92 1 0 =
      (5519295148566637309872241951325458624767107775854186542404260048436059935362150545055680667633673 : ℤ) := by
  rw [tableEnergyNumerator_eq KsIndex.NegSignProd.valid KsIndex.NegSignProd.wP92 1 0
        (fun n hn => covLowE hn)]
  have h : energyNumerator KsIndex.NegSignProd.wP92 1 0 =
      ∑ n ∈ KsIndex.NegSignProd.wP92, ((6 * n + 1) ^ 2 - 4) *
        ((entriesE[idxE n]?.getD (0, 0)).1) ^ 2 / |6 * n + 1| := by
    unfold energyNumerator
    refine Finset.sum_congr rfl ?_
    intro n hn
    rw [sampleNumE_cache hn]
  rw [h]
  decide +kernel

theorem eP92_r_fast :
    tableEnergyRadius KsIndex.NegSignProd.t KsIndex.NegSignProd.wP92 1 0 =
      (45009350561758509184752223164962218901486955353909376583073068939415715277841892340798534 : ℤ) := by
  rw [tableEnergyRadius_eq KsIndex.NegSignProd.valid KsIndex.NegSignProd.wP92 1 0
        (fun n hn => covLowE hn)]
  have h : energyRadius KsIndex.NegSignProd.wP92 1 0 =
      ∑ n ∈ KsIndex.NegSignProd.wP92, (|((6 * n + 1) ^ 2 - 4)| * (entriesE[idxE n]?.getD (0, 0)).2 *
        (2 * |(entriesE[idxE n]?.getD (0, 0)).1| + (entriesE[idxE n]?.getD (0, 0)).2) /
          |6 * n + 1| + 2) := by
    unfold energyRadius
    refine Finset.sum_congr rfl ?_
    intro n hn
    rw [sampleNumE_cache hn, sampleRadE_cache hn]
  rw [h]
  decide +kernel

