/-! Generated integer coefficient certificates for four rational functions.

Each exponent/parity group has numerator and denominator coefficient vectors in
`y = x - 2051`, together with rational bounds `[L, U]`. The theorems below prove
the coefficient inequalities in Lean and apply
`rational_integer_coefficients_bound` for `y ≥ 0`. Identification of these
rational functions with the trial multipliers is supplied separately.
-/

namespace KsIndex.AlphaMultiplier

-- family A parity 0 base -6: multiplier bound [0, 1/10000]  (degree 6)
def p_A0 : Fin 7 → ℤ := ![1384094062087684936719727771583793283067284199790218519054487, 3374210482257653212262748307207273528983562754529604348637, 3290320256513379847422460473124363847989625000000000000, 1604255811408673122430260872440169648625000000000000, 391091629030432519918750000000000000000000000000, 38136677623640421250000000000000000000000000, 0]
def d_A0 : Fin 7 → ℤ := ![14599552809423143151942361801627384142852191097182885223758012500, 42679876371641220285736734972914903960224799065518375000000000, 51987061461286867563916877113144655259504687500000000000000, 33772707166089449868374274941531250000000000000000000000, 12341239061808377243867187500000000000000000000000000, 2405194173984375000000000000000000000000000000000, 195312500000000000000000000000000000000000000]
def L_A0 : ℚ := 0/1
def U_A0 : ℚ := 1/10000
/-- Multiplier `A` parity `0` (base -6): for y = x - 2051 ≥ 0 (x ≥ 2051),
    the rational function (Σ pᵢ yⁱ)/(Σ dᵢ yⁱ) lies in [L_A0, U_A0]. -/
theorem mult_bound_A0 (y : ℝ) (hy : 0 ≤ y) :
    (L_A0 : ℝ) ≤ (∑ i, (p_A0 i : ℝ) * y ^ i.val) / (∑ i, (d_A0 i : ℝ) * y ^ i.val) ∧
      (∑ i, (p_A0 i : ℝ) * y ^ i.val) / (∑ i, (d_A0 i : ℝ) * y ^ i.val) ≤ (U_A0 : ℝ) :=
  rational_integer_coefficients_bound 7 p_A0 d_A0 L_A0 U_A0 y hy
    (by decide) (by decide)
    (by intro i; fin_cases i <;> norm_num [p_A0, d_A0, L_A0, U_A0])
    (by intro i; fin_cases i <;> norm_num [p_A0, d_A0, L_A0, U_A0])

