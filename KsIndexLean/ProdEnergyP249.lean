theorem checkedE (i : Fin 64) :
    (entriesE[i.val]?.getD (0, 0)).1 =
        tableSampleNumerator KsIndex.PositiveEnergyAlphaLowProd.tFast (2 * modeE i.val) ∧
    (entriesE[i.val]?.getD (0, 0)).2 =
        tableSampleRadius KsIndex.PositiveEnergyAlphaLowProd.tFast (2 * modeE i.val) := by
  rw [← KsIndex.AlphaLowTreeBackend.table_eq]
  fin_cases i <;> decide +kernel

def idxE (n : ℤ) : ℕ := (n - (7744)).toNat

lemma mem_wP249 {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP249) : (7743 : ℤ) < n ∧ n ≤ 7807 := by
  simpa only [KsIndex.NegSignProd.wP249, Finset.mem_Ioc] using hn

lemma idxE_lt {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP249) : idxE n < 64 := by
  obtain ⟨h1, h2⟩ := mem_wP249 hn; simp only [idxE]; omega

lemma two_modeE_idx {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP249) :
    2 * modeE (idxE n) = 2 * n + 0 := by
  obtain ⟨h1, h2⟩ := mem_wP249 hn; simp only [idxE, modeE]; omega

lemma covLowE {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP249) : SampleCovered 8196 (2 * n + 0) := by
  obtain ⟨h1, h2⟩ := mem_wP249 hn; exact sampleCovered_of_bound (by omega)

lemma covFastE {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP249) : SampleCovered 16389 (2 * n + 0) := by
  obtain ⟨h1, h2⟩ := mem_wP249 hn; exact sampleCovered_of_bound (by omega)

lemma sampleNumE_cache {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP249) :
    sampleNumerator (2 * n + 0) = (entriesE[idxE n]?.getD (0, 0)).1 := by
  have hc := (checkedE ⟨idxE n, idxE_lt hn⟩).1
  rw [two_modeE_idx hn] at hc
  have hbridge := tableSampleNumerator_eq KsIndex.PositiveEnergyAlphaLowProd.valid (covFastE hn)
  exact (hc.trans hbridge).symm

lemma sampleRadE_cache {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP249) :
    sampleRadius (2 * n + 0) = (entriesE[idxE n]?.getD (0, 0)).2 := by
  have hc := (checkedE ⟨idxE n, idxE_lt hn⟩).2
  rw [two_modeE_idx hn] at hc
  have hbridge := tableSampleRadius_eq KsIndex.PositiveEnergyAlphaLowProd.valid (covFastE hn)
  exact (hc.trans hbridge).symm

theorem eP249_c_fast :
    tableEnergyNumerator KsIndex.NegSignProd.t KsIndex.NegSignProd.wP249 1 0 =
      (55163135607802133298690402229789828731754435647410947892541051487192703504602255987598273407237 : ℤ) := by
  rw [tableEnergyNumerator_eq KsIndex.NegSignProd.valid KsIndex.NegSignProd.wP249 1 0
        (fun n hn => covLowE hn)]
  have h : energyNumerator KsIndex.NegSignProd.wP249 1 0 =
      ∑ n ∈ KsIndex.NegSignProd.wP249, ((6 * n + 1) ^ 2 - 4) *
        ((entriesE[idxE n]?.getD (0, 0)).1) ^ 2 / |6 * n + 1| := by
    unfold energyNumerator
    refine Finset.sum_congr rfl ?_
    intro n hn
    rw [sampleNumE_cache hn]
  rw [h]
  decide +kernel

theorem eP249_r_fast :
    tableEnergyRadius KsIndex.NegSignProd.t KsIndex.NegSignProd.wP249 1 0 =
      (1355339906901729593047243506828422818117832033448763999359355223064519175592951202386874 : ℤ) := by
  rw [tableEnergyRadius_eq KsIndex.NegSignProd.valid KsIndex.NegSignProd.wP249 1 0
        (fun n hn => covLowE hn)]
  have h : energyRadius KsIndex.NegSignProd.wP249 1 0 =
      ∑ n ∈ KsIndex.NegSignProd.wP249, (|((6 * n + 1) ^ 2 - 4)| * (entriesE[idxE n]?.getD (0, 0)).2 *
