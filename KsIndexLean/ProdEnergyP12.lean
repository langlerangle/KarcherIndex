theorem checkedE (i : Fin 64) :
    (entriesE[i.val]?.getD (0, 0)).1 =
        tableSampleNumerator KsIndex.PositiveEnergyAlphaLowProd.tFast (2 * modeE i.val) ∧
    (entriesE[i.val]?.getD (0, 0)).2 =
        tableSampleRadius KsIndex.PositiveEnergyAlphaLowProd.tFast (2 * modeE i.val) := by
  fin_cases i <;> decide +kernel

def idxE (n : ℤ) : ℕ := (n - (-7424)).toNat

lemma mem_wP12 {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP12) : (-7425 : ℤ) < n ∧ n ≤ -7361 := by
  simpa only [KsIndex.NegSignProd.wP12, Finset.mem_Ioc] using hn

lemma idxE_lt {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP12) : idxE n < 64 := by
  obtain ⟨h1, h2⟩ := mem_wP12 hn; simp only [idxE]; omega

lemma two_modeE_idx {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP12) :
    2 * modeE (idxE n) = 2 * n + 0 := by
  obtain ⟨h1, h2⟩ := mem_wP12 hn; simp only [idxE, modeE]; omega

lemma covLowE {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP12) : SampleCovered 8196 (2 * n + 0) := by
  obtain ⟨h1, h2⟩ := mem_wP12 hn; exact sampleCovered_of_bound (by omega)

lemma covFastE {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP12) : SampleCovered 16389 (2 * n + 0) := by
  obtain ⟨h1, h2⟩ := mem_wP12 hn; exact sampleCovered_of_bound (by omega)

lemma sampleNumE_cache {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP12) :
    sampleNumerator (2 * n + 0) = (entriesE[idxE n]?.getD (0, 0)).1 := by
  have hc := (checkedE ⟨idxE n, idxE_lt hn⟩).1
  rw [two_modeE_idx hn] at hc
  have hbridge := tableSampleNumerator_eq KsIndex.PositiveEnergyAlphaLowProd.valid (covFastE hn)
  exact (hc.trans hbridge).symm

lemma sampleRadE_cache {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP12) :
    sampleRadius (2 * n + 0) = (entriesE[idxE n]?.getD (0, 0)).2 := by
  have hc := (checkedE ⟨idxE n, idxE_lt hn⟩).2
  rw [two_modeE_idx hn] at hc
  have hbridge := tableSampleRadius_eq KsIndex.PositiveEnergyAlphaLowProd.valid (covFastE hn)
  exact (hc.trans hbridge).symm

theorem eP12_c_fast :
    tableEnergyNumerator KsIndex.NegSignProd.t KsIndex.NegSignProd.wP12 1 0 =
      (546540136400631926951497711513255571041380269606998922709197952633595573798464934212486117906762 : ℤ) := by
  rw [tableEnergyNumerator_eq KsIndex.NegSignProd.valid KsIndex.NegSignProd.wP12 1 0
        (fun n hn => covLowE hn)]
  have h : energyNumerator KsIndex.NegSignProd.wP12 1 0 =
      ∑ n ∈ KsIndex.NegSignProd.wP12, ((6 * n + 1) ^ 2 - 4) *
        ((entriesE[idxE n]?.getD (0, 0)).1) ^ 2 / |6 * n + 1| := by
    unfold energyNumerator
    refine Finset.sum_congr rfl ?_
    intro n hn
    rw [sampleNumE_cache hn]
  rw [h]
  decide +kernel

theorem eP12_r_fast :
    tableEnergyRadius KsIndex.NegSignProd.t KsIndex.NegSignProd.wP12 1 0 =
      (4480986184265333992342393103095789528894552331264758873990869199552485961577344782703217 : ℤ) := by
  rw [tableEnergyRadius_eq KsIndex.NegSignProd.valid KsIndex.NegSignProd.wP12 1 0
        (fun n hn => covLowE hn)]
  have h : energyRadius KsIndex.NegSignProd.wP12 1 0 =
      ∑ n ∈ KsIndex.NegSignProd.wP12, (|((6 * n + 1) ^ 2 - 4)| * (entriesE[idxE n]?.getD (0, 0)).2 *
        (2 * |(entriesE[idxE n]?.getD (0, 0)).1| + (entriesE[idxE n]?.getD (0, 0)).2) /
          |6 * n + 1| + 2) := by
    unfold energyRadius
    refine Finset.sum_congr rfl ?_
    intro n hn
    rw [sampleNumE_cache hn, sampleRadE_cache hn]
  rw [h]
  decide +kernel

