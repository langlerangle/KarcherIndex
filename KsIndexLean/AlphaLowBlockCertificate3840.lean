theorem actual_bound (n : ℤ) :
    |(∑ i : Fin 256, (rationalKernelWeight n ((-12545 : ℤ)+i.val) : ℝ) *
        sample (2*((-12545 : ℤ)+i.val)+1)) -
      (blockLinearNumerator (-12545) n center : ℝ)/10^51| ≤
      (blockLinearRadius (-12545) n radius : ℝ)/10^51 := by
