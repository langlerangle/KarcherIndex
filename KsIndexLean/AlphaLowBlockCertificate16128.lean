theorem actual_bound (n : ℤ) :
    |(∑ i : Fin 256, (rationalKernelWeight n ((-257 : ℤ)+i.val) : ℝ) *
        sample (2*((-257 : ℤ)+i.val)+1)) -
      (blockLinearNumerator (-257) n center : ℝ)/10^51| ≤
      (blockLinearRadius (-257) n radius : ℝ)/10^51 := by
