theorem checkedE (i : Fin 64) :
    (entriesE[i.val]?.getD (0, 0)).1 =
        tableSampleNumerator KsIndex.PositiveEnergyAlphaLowProd.tFast (2 * modeE i.val) ∧
    (entriesE[i.val]?.getD (0, 0)).2 =
        tableSampleRadius KsIndex.PositiveEnergyAlphaLowProd.tFast (2 * modeE i.val) := by
  fin_cases i <;> decide +kernel

def idxE (n : ℤ) : ℕ := (n - (3264)).toNat

lemma mem_wP179 {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP179) : (3263 : ℤ) < n ∧ n ≤ 3327 := by
  simpa only [KsIndex.NegSignProd.wP179, Finset.mem_Ioc] using hn

lemma idxE_lt {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP179) : idxE n < 64 := by
  obtain ⟨h1, h2⟩ := mem_wP179 hn; simp only [idxE]; omega

lemma two_modeE_idx {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP179) :
    2 * modeE (idxE n) = 2 * n + 0 := by
  obtain ⟨h1, h2⟩ := mem_wP179 hn; simp only [idxE, modeE]; omega

lemma covLowE {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP179) : SampleCovered 8196 (2 * n + 0) := by
  obtain ⟨h1, h2⟩ := mem_wP179 hn; exact sampleCovered_of_bound (by omega)

lemma covFastE {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP179) : SampleCovered 16389 (2 * n + 0) := by
  obtain ⟨h1, h2⟩ := mem_wP179 hn; exact sampleCovered_of_bound (by omega)

lemma sampleNumE_cache {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP179) :
    sampleNumerator (2 * n + 0) = (entriesE[idxE n]?.getD (0, 0)).1 := by
  have hc := (checkedE ⟨idxE n, idxE_lt hn⟩).1
  rw [two_modeE_idx hn] at hc
  have hbridge := tableSampleNumerator_eq KsIndex.PositiveEnergyAlphaLowProd.valid (covFastE hn)
  exact (hc.trans hbridge).symm

lemma sampleRadE_cache {n : ℤ} (hn : n ∈ KsIndex.NegSignProd.wP179) :
    sampleRadius (2 * n + 0) = (entriesE[idxE n]?.getD (0, 0)).2 := by
  have hc := (checkedE ⟨idxE n, idxE_lt hn⟩).2
  rw [two_modeE_idx hn] at hc
  have hbridge := tableSampleRadius_eq KsIndex.PositiveEnergyAlphaLowProd.valid (covFastE hn)
  exact (hc.trans hbridge).symm

theorem eP179_c_fast :
    tableEnergyNumerator KsIndex.NegSignProd.t KsIndex.NegSignProd.wP179 1 0 =
      (210368812883823418863744110544481989220795684929796377897850130389472309210692765416653207649255 : ℤ) := by
  rw [tableEnergyNumerator_eq KsIndex.NegSignProd.valid KsIndex.NegSignProd.wP179 1 0
        (fun n hn => covLowE hn)]
  have h : energyNumerator KsIndex.NegSignProd.wP179 1 0 =
      ∑ n ∈ KsIndex.NegSignProd.wP179, ((6 * n + 1) ^ 2 - 4) *
        ((entriesE[idxE n]?.getD (0, 0)).1) ^ 2 / |6 * n + 1| := by
    unfold energyNumerator
    refine Finset.sum_congr rfl ?_
    intro n hn
    rw [sampleNumE_cache hn]
  rw [h]
  decide +kernel

